## Forming Worlds Lab style, dark mode.
## Colours must match PALETTE["dark"] and SURFACES["dark"] in __init__.py.

## Figure: one column of a two-column page; PDF and PS embed TrueType fonts,
## SVG draws text as paths so it renders without the fonts installed
figure.figsize: 3.5, 2.6
figure.dpi: 150
figure.constrained_layout.use: True
figure.facecolor: 0D0C17
savefig.facecolor: 0D0C17
savefig.dpi: 300
pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: path

## Type: IBM Plex Sans with true italic for math variables
font.family: IBM Plex Sans, DejaVu Sans
font.monospace: IBM Plex Mono, DejaVu Sans Mono
font.size: 8
mathtext.fontset: custom
mathtext.rm: IBM Plex Sans
mathtext.sf: IBM Plex Sans
mathtext.it: IBM Plex Sans:italic
mathtext.bf: IBM Plex Sans:medium
mathtext.cal: IBM Plex Sans:italic
mathtext.fallback: stixsans
axes.unicode_minus: True

## Colours
axes.prop_cycle: cycler('color', ['59B1EE', 'DC4C00', 'B7E2B2', 'FCB71E', '8A67F2', '46999E', 'BA6384', '98AB71'])
image.cmap: cmc.batlow
axes.facecolor: 0D0C17
axes.edgecolor: 9C98AE
axes.labelcolor: ECEAF4
text.color: ECEAF4
xtick.color: 9C98AE
ytick.color: 9C98AE
xtick.labelcolor: ECEAF4
ytick.labelcolor: ECEAF4
grid.color: 2A2838
legend.labelcolor: ECEAF4
boxplot.boxprops.color: ECEAF4
boxplot.whiskerprops.color: ECEAF4
boxplot.capprops.color: ECEAF4
boxplot.flierprops.markeredgecolor: ECEAF4
errorbar.capsize: 0

## Axes: open frame, outward ticks, no grid
axes.spines.top: False
axes.spines.right: False
axes.linewidth: 0.6
axes.grid: False
axes.titlesize: 8.5
axes.titleweight: medium
axes.titlelocation: left
axes.labelsize: 8
axes.labelpad: 3
xtick.direction: out
ytick.direction: out
xtick.labelsize: 7
ytick.labelsize: 7
xtick.major.size: 3
ytick.major.size: 3
xtick.minor.size: 1.6
ytick.minor.size: 1.6
xtick.major.width: 0.6
ytick.major.width: 0.6
xtick.minor.width: 0.5
ytick.minor.width: 0.5
xtick.minor.visible: True
ytick.minor.visible: True
grid.linewidth: 0.5

## Marks
lines.linewidth: 1.3
lines.markersize: 3.5
patch.linewidth: 0.5
scatter.edgecolors: face

## Legend
legend.frameon: False
legend.fontsize: 7
legend.title_fontsize: 7
legend.handlelength: 1.4
legend.borderaxespad: 0.3
