## Forming Worlds Lab figure style, paper mode (fwl-visual-language 0.1.0).
## Generated from the lab tokens; edit tokens/fwl.json, not this file.
## image.cmap names a Crameri map: import cmcrameri before plotting images.

## Figure: one column of a two-column page; PDF and PS embed TrueType fonts,
## SVG draws text as paths so it renders without the fonts installed
figure.figsize: 3.5, 2.6
figure.dpi: 150
figure.constrained_layout.use: True
figure.facecolor: FFFFFF
savefig.facecolor: FFFFFF
savefig.dpi: 300
pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: path

## Type: Geist for words, Inter for math and Greek
font.family: Geist, Inter, DejaVu Sans
font.monospace: Geist Mono, DejaVu Sans Mono
font.size: 8.5
mathtext.fontset: custom
mathtext.rm: Inter
mathtext.sf: Inter
mathtext.it: Inter:italic
mathtext.bf: Inter:medium
mathtext.cal: Inter:italic
mathtext.fallback: stixsans
axes.unicode_minus: True

## Colours
axes.prop_cycle: cycler('color', ['0072A1', 'B74B21', '20A976', '4E2585', 'BC8D03', '124F54', '741721', '6E747A'])
image.cmap: cmc.batlow
axes.facecolor: FFFFFF
axes.edgecolor: 6B747C
axes.labelcolor: 010305
text.color: 010305
xtick.color: 6B747C
ytick.color: 6B747C
xtick.labelcolor: 010305
ytick.labelcolor: 010305
grid.color: CBD2D7
legend.labelcolor: 010305
boxplot.boxprops.color: 010305
boxplot.whiskerprops.color: 010305
boxplot.capprops.color: 010305
boxplot.flierprops.markeredgecolor: 010305
errorbar.capsize: 0

## Axes: open frame, outward ticks, no grid
axes.spines.top: False
axes.spines.right: False
axes.linewidth: 0.6
axes.grid: False
axes.titlesize: 9.5
axes.titleweight: medium
axes.titlelocation: left
axes.labelsize: 9
axes.labelpad: 3
xtick.direction: out
ytick.direction: out
xtick.labelsize: 8
ytick.labelsize: 8
xtick.major.size: 3
ytick.major.size: 3
xtick.minor.size: 1.6
ytick.minor.size: 1.6
xtick.major.width: 0.6
ytick.major.width: 0.6
xtick.minor.width: 0.5
ytick.minor.width: 0.5
xtick.minor.visible: True
ytick.minor.visible: True
grid.linewidth: 0.5

## Marks
lines.linewidth: 1.3
lines.markersize: 3.5
patch.linewidth: 0.5
scatter.edgecolors: face

## Legend
legend.frameon: False
legend.fontsize: 8
legend.title_fontsize: 8
legend.handlelength: 1.4
legend.borderaxespad: 0.3
