## Forming Worlds Lab style, light mode.
## Colours must match PALETTE["light"] and SURFACES["light"] in __init__.py.

## Figure: one column of a two-column page; PDF and PS embed TrueType fonts,
## SVG draws text as paths so it renders without the fonts installed
figure.figsize: 3.5, 2.6
figure.dpi: 150
figure.constrained_layout.use: True
figure.facecolor: FFFFFF
savefig.facecolor: FFFFFF
savefig.dpi: 300
pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: path

## Type: IBM Plex Sans with true italic for math variables
font.family: IBM Plex Sans, DejaVu Sans
font.monospace: IBM Plex Mono, DejaVu Sans Mono
font.size: 8
mathtext.fontset: custom
mathtext.rm: IBM Plex Sans
mathtext.sf: IBM Plex Sans
mathtext.it: IBM Plex Sans:italic
mathtext.bf: IBM Plex Sans:medium
mathtext.cal: IBM Plex Sans:italic
mathtext.fallback: stixsans
axes.unicode_minus: True

## Colours
axes.prop_cycle: cycler('color', ['008FF3', 'C94D45', '388E6A', 'C98702', '6C3FB4', '275F60', '90003E', '556C00'])
image.cmap: cmc.batlow
axes.facecolor: FFFFFF
axes.edgecolor: 615D70
axes.labelcolor: 17151F
text.color: 17151F
xtick.color: 615D70
ytick.color: 615D70
xtick.labelcolor: 17151F
ytick.labelcolor: 17151F
grid.color: E1DFEA
legend.labelcolor: 17151F
boxplot.boxprops.color: 17151F
boxplot.whiskerprops.color: 17151F
boxplot.capprops.color: 17151F
boxplot.flierprops.markeredgecolor: 17151F
errorbar.capsize: 0

## Axes: open frame, outward ticks, no grid
axes.spines.top: False
axes.spines.right: False
axes.linewidth: 0.6
axes.grid: False
axes.titlesize: 8.5
axes.titleweight: medium
axes.titlelocation: left
axes.labelsize: 8
axes.labelpad: 3
xtick.direction: out
ytick.direction: out
xtick.labelsize: 7
ytick.labelsize: 7
xtick.major.size: 3
ytick.major.size: 3
xtick.minor.size: 1.6
ytick.minor.size: 1.6
xtick.major.width: 0.6
ytick.major.width: 0.6
xtick.minor.width: 0.5
ytick.minor.width: 0.5
xtick.minor.visible: True
ytick.minor.visible: True
grid.linewidth: 0.5

## Marks
lines.linewidth: 1.3
lines.markersize: 3.5
patch.linewidth: 0.5
scatter.edgecolors: face

## Legend
legend.frameon: False
legend.fontsize: 7
legend.title_fontsize: 7
legend.handlelength: 1.4
legend.borderaxespad: 0.3
